# Dua akun uji baru yang emailnya telah dikonfirmasi, belum onboarding.
# Salin ke .env.rls-test (diabaikan git), isi lokal; jangan kirim kredensial ke chat.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
# Isi hanya untuk dua akun uji khusus yang boleh diberi fixture sementara.
RLS_TEST_ALLOW_FIXTURES=
